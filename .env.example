# BrandPulse AI - Environment Configuration

# Server Settings
APP_ENV=development
APP_NAME=BrandPulse AI
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Data Mode: 'production' (strictly real verified data) or 'demo' (synthetic showcase data)
APP_DATA_MODE=production

# Security Settings
SECRET_KEY=brandpulse_super_secret_jwt_key_2026_change_in_production!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite; change to PostgreSQL for high-scale deployments)
DATABASE_URL=sqlite:///./brandpulse.db
# DATABASE_URL=postgresql://brandpulse_user:brandpulse_pass@localhost:5432/brandpulse_db

# Redis Caching & Queue Configuration
REDIS_URL=redis://localhost:6379/0

# Batch Processing
IMPORT_BATCH_SIZE=500
AI_BATCH_SIZE=100
MAX_UPLOAD_SIZE_MB=100

# AI Configuration
ENABLE_AI=True
AI_PROVIDER=local_rule_based
AI_MODEL=BrandPulse-Universal-v2
USE_MOCK_AI=False

# External AI Provider (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LOG_LEVEL=INFO
